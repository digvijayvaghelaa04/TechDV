# Frontend Environment Variables Example
# Copy this file to .env and fill in values

# 🔴 PRODUCTION: Replace with your Render backend URL
VITE_API_URL=https://your-backend.onrender.com/api/v1
VITE_APP_URL=https://your-app.vercel.app

# Feature Flags
VITE_ENABLE_SOCIAL_LOGIN=false
VITE_ENABLE_LIVE_CLASSES=false
VITE_ENABLE_CHAT=false

# Payment Gateway (Razorpay Public Key - safe to expose)
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_here

# Cloudinary (Public - safe to expose in frontend)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
